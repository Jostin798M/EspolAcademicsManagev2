# Plantilla de configuracion para el servidor (AlwaysData).
# Copiar como backend/.env y completar con los datos reales.
# NUNCA subir el archivo .env al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tucuenta.alwaysdata.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://tucuenta.alwaysdata.net

# Base de datos MySQL de AlwaysData
DB_ENGINE=mysql
DB_NAME=tucuenta_espolacademics
DB_USER=tucuenta
DB_PASSWORD=tu-contrasena-de-mysql
DB_HOST=mysql-tucuenta.alwaysdata.net
DB_PORT=3306

# Descomentar solo si mysqlclient no se pudo instalar en el servidor
# DB_DRIVER=pymysql

# Activar cuando el dominio ya responda por HTTPS
DJANGO_SECURE_SSL_REDIRECT=False

# ── API de consulta (/api/) ──────────────────────────────────
# Se entra de tres formas y basta con una:
#   1. sesion iniciada en /admin/ con un usuario SUPERADMIN (navegador)
#   2. token de POST /api/auth/login/ (otras aplicaciones)
#   3. clave en el encabezado X-API-Key (scripts propios)
#
# Entra cualquier cuenta activa, con el rol que tenga.
#
# Modo del catalogo academico (cursos, modulos, tareas, quizzes, reportes)
# para quien NO se identifica:
#   privada -> hay que identificarse siempre (recomendado)
#   publica -> el catalogo se puede leer sin credenciales, solo lectura
# Los datos personales (usuarios, estudiantes) y todo lo que escriba exigen
# identificarse, aunque el modo sea publico.
API_MODO=privada

# Roles que pueden ENTRAR a la API (separados por coma).
#
# Entran los cuatro: cada uno accede a lo que le toca (el administrador a su
# facultad, el profesor a sus cursos, el estudiante a los suyos), y eso lo
# decide backend/api/permisos.py, no esta linea.
#
# OJO: si aqui pones solo SUPERADMIN, a los demas roles se les cierra la API
# ENTERA y ni el sitio web ni la app movil les dejaran entrar. Recortalo solo
# si de verdad quieres cerrarle la puerta a un rol completo.
API_ROLES=SUPERADMIN,ADMIN,PROFESOR,ESTUDIANTE

# Clave para programas externos. Es OPCIONAL: dejala vacia si solo la vas
# a consultar desde el navegador con tu sesion iniciada. Quien la usa no
# tiene limites, asi que tratala como una contrasena de administrador.
API_CLAVE=cambia-esto-por-una-clave-larga-y-aleatoria

# Duracion de los tokens que se entregan en /api/auth/login/ (en dias).
# API_TOKEN_DIAS = valor por defecto; 0 = no caducan.
# API_TOKEN_DIAS_MAX = lo maximo que puede pedir la aplicacion.
API_TOKEN_DIAS=30
API_TOKEN_DIAS_MAX=365

# Freno a la fuerza bruta en el login de la API.
API_LOGIN_INTENTOS=10
API_LOGIN_BLOQUEO_MIN=5

# Dominios autorizados a consultar la API desde un navegador.
# '*' = cualquiera. Ejemplo: https://misitio.com,https://otro.com
API_ORIGENES=*

# Tamano de pagina de los listados (?tam=)
API_TAM_PAGINA=25
API_TAM_PAGINA_MAX=100
